# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=false
WEBAPP_URL=http://localhost:8000

# Database Settings
DATABASE_PATH=data/food_bot.db
USE_SUPABASE=false
SUPABASE_URL=
SUPABASE_KEY=

# Automated Weekly Menu Generation (Every Monday at 09:00)
AUTO_UPDATE_DAY_OF_WEEK=mon
AUTO_UPDATE_HOUR=9
AUTO_UPDATE_MINUTE=0
